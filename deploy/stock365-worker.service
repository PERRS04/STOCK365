[Unit]
Description=STOCK365 Queue Worker
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/stock365
ExecStart=/usr/bin/php8.3 artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
